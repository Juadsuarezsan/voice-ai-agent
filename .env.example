# Copy to .env and fill in what you have. Every variable is optional: with none
# set, the API runs fully offline on deterministic stub backends.

# --- LLM (reasoner) ---------------------------------------------------------
ANTHROPIC_API_KEY=                      # enables ClaudeReasoner; empty -> StubReasoner
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
LLM_TIMEOUT_S=20                        # per-request timeout (seconds)
LLM_MAX_RETRIES=3                       # tenacity attempts on 429/5xx/timeouts
LLM_MAX_TOKENS=400
PRICE_INPUT_PER_MTOK=3.0                # USD per 1M input tokens (cost accounting)
PRICE_OUTPUT_PER_MTOK=15.0              # USD per 1M output tokens

# --- Speech to text ------------------------------------------------------------
WHISPER_BACKEND=stub                    # stub | local (pip install ".[stt]") | api
WHISPER_MODEL=base                      # local only: tiny | base | small | medium | large-v3
OPENAI_API_KEY=                         # api only (hosted whisper-1)
WHISPER_API_PRICE_PER_MIN=0.006
STT_TIMEOUT_S=30

# --- Text to speech --------------------------------------------------------------
TTS_BACKEND=stub                        # stub | elevenlabs | xtts (pip install ".[tts]")
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_PRICE_PER_1K_CHARS=0.30
TTS_TIMEOUT_S=15

# --- Voice activity detection --------------------------------------------------
VAD_BACKEND=energy                      # energy | silero (pip install ".[vad]")
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=500

# --- Persistence -------------------------------------------------------------
LOGGER_BACKEND=memory                   # memory | sqlite | postgres
SQLITE_PATH=data/conversations.db
DATABASE_URL=                           # postgres only, e.g. postgresql://voice:voice@localhost:5432/voice
DB_POOL_MIN=1
DB_POOL_MAX=8
REDACT_PII=true                         # pseudonymise names / mask phones before persisting

# --- HTTP API ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
RATE_LIMIT=30/minute                    # slowapi syntax, applied to POST /api/turn
MAX_AUDIO_BYTES=5000000
MAX_TEXT_CHARS=2000
TURN_LATENCY_TARGET_MS=800

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LANGSMITH_TRACING=false                 # true + key -> LangGraph traces to LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voice-ai-agent

# --- Telephony / WebRTC (production channel, not used by the HTTP demo) ------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
